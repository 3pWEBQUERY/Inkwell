{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "public/sw.js"],
      "env": [
        "NEXT_PUBLIC_*",
        "API_URL",
        "API_INTERNAL_TOKEN",
        "SESSION_COOKIE_NAME",
        "ADMIN_IP_ALLOWLIST",
        "DATABASE_URL",
        "SESSION_SECRET",
        "APP_ORIGIN",
        "MAIL_*",
        "SMTP_*",
        "S3_*",
        "VAPID_*",
        "APPLE_*",
        "RP_ID",
        "CRON_SECRET",
        "LOG_LEVEL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
