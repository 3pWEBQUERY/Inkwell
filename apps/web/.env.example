# --- Web service -----------------------------------------------------------
NODE_ENV=development

# Internal URL of the API service (Railway private networking in production).
API_URL=http://localhost:4000
# Must match API_INTERNAL_TOKEN of the api service. 32+ random characters.
API_INTERNAL_TOKEN=change-me-change-me-change-me-change-me

SESSION_COOKIE_NAME=inkwell_session

# Comma-separated IPs or CIDR ranges allowed to open /admin (in addition to the admin role).
# Empty = allow all (development only).
ADMIN_IP_ALLOWLIST=

# --- Public --------------------------------------------------------------------
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_BUILD_ID=dev
