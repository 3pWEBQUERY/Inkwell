# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Public origin of the web app (used in mails, WebAuthn origin, push payload links).
APP_ORIGIN=http://localhost:3000
# WebAuthn relying party id (hostname of APP_ORIGIN).
RP_ID=localhost

# Shared secret the web service presents on every request (defense in depth on
# top of Railway private networking). 32+ random characters.
API_INTERNAL_TOKEN=change-me-change-me-change-me-change-me

# Secret used to hash e-mail addresses for lookup and to derive HMAC keys. 32+ random characters.
SESSION_SECRET=change-me-change-me-change-me-change-me

# Secret the cron service presents to /v1/jobs/*.
CRON_SECRET=change-me-change-me-change-me-change-me

# --- Database ------------------------------------------------------------------
DATABASE_URL=postgres://inkwell:inkwell@localhost:5432/inkwell

# --- Mail (EU provider, SMTP) -----------------------------------------------------
# MAIL_TRANSPORT=console prints mails to the log; smtp sends them.
MAIL_TRANSPORT=console
MAIL_FROM="Inkwell <no-reply@example.ch>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Object storage (S3-compatible, EU region): avatars and export archives ------
# On Railway these are references to the bucket service (see .railway/railway.ts).
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 1 = path-style addressing (<endpoint>/<bucket>/<key>, e.g. MinIO). Railway buckets: 0.
S3_FORCE_PATH_STYLE=0

# --- Web Push (generate once with: npx web-push generate-vapid-keys) --------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hallo@example.ch

# --- Sign in with Apple ------------------------------------------------------------
APPLE_CLIENT_ID=
